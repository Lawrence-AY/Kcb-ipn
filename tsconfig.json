{
	"compilerOptions": {
		/* Base Options: */
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"verbatimModuleSyntax": false,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		/* Strictness */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "Node",
		"module": "commonjs",
		"outDir": "dist",
		"rootDir": "src",
		"lib": ["es2022"],
		"types": ["node"]
	},
	"exclude": ["node_modules", "dist", "tests"],
	"include": ["src"]
}
